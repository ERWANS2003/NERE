# Configuration pour Windows Server IIS
APP_NAME="Intranet Nere Mining"
APP_ENV=production
APP_KEY=base64:+iLZ7m5EZBA/ziR4q8+ueGzD3xVIriZyTKuk94HTE7w=
APP_DEBUG=false
APP_URL=http://your-server-domain.com

# Configuration HTTPS pour la production (à configurer après installation SSL)
FORCE_HTTPS=false
TRUSTED_PROXIES=*

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Configuration Base de données - ADAPTEZ VOS PARAMÈTRES
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nere_intranet_prod
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD

# Alternative pour SQL Server si vous préférez
# DB_CONNECTION=sqlsrv
# DB_HOST=127.0.0.1
# DB_PORT=1433
# DB_DATABASE=nere_intranet_prod
# DB_USERNAME=sa
# DB_PASSWORD=YOUR_SECURE_DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configuration Email production - ADAPTEZ VOS PARAMÈTRES
MAIL_MAILER=smtp
MAIL_SCHEME=http
MAIL_HOST=smtp.your-domain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@nere-mining.com
MAIL_PASSWORD=YOUR_EMAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@nere-mining.com"
MAIL_FROM_NAME="${APP_NAME}"

# Services externes (optionnels)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Configuration Windows Server spécifique
WINDOWS_SERVER=true
IIS_SERVER=true