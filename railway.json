{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "npm install --include=dev --no-audit --no-fund && npm run build"
  },
  "deploy": {
    "startCommand": "PHP_CLI_SERVER_WORKERS=8 php -S 0.0.0.0:$PORT -t public server.php",
    "restartPolicyCondition": "on-failure",
    "restartPolicyMaxRetryCount": 3
  }
}
