APP_NAME="Intranet Nere Mining"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Local dev
# APP_URL=http://localhost:8000
# Production (serveur Windows IIS)
APP_URL=http://192.168.10.206

# SchÃ©ma des URLs gÃ©nÃ©rÃ©es. Laisser false en local : le serveur intÃ©grÃ© de PHP
# ne gÃ¨re pas TLS, et forcer https provoque
# "Invalid request (Unsupported SSL request)" dans la console.
# Passer Ã  true (avec TRUSTED_PROXIES) uniquement derriÃ¨re un reverse proxy
# qui termine le SSL, sur le serveur Windows.
FORCE_HTTPS=false

# Proxies de confiance pour lire X-Forwarded-Proto. Laisser vide en local.
#TRUSTED_PROXIES=*

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=nere_intranet
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Undefined falls back to "secure only on https", so the same config works
# locally over http and on the Windows server behind TLS.
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="intranet@nere.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
